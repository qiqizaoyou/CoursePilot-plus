<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随课 · CoursePilot" Width="1136" Height="860" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F6F6F6"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#202020"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#828282"/>
    <Style TargetType="Button" x:Key="BaseButton">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#252525"/>
      <Setter Property="BorderBrush" Value="#DFDFDF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.36"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#777777"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#202020"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#202020"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E5E5"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
    </Style>
  </Window.Resources>
  <Grid Background="#F6F6F6">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Background="#FCFCFC" BorderBrush="#E4E4E4" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="22,30,20,24" MinHeight="620">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="36" Height="36" Background="#202020" CornerRadius="11">
              <TextBlock Text="随" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="随课" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="COURSEPILOT" FontSize="9" Foreground="#888888" Margin="0,2,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="工作空间" Foreground="#999999" FontSize="10" Margin="2,51,0,14"/>
          <Border Background="#EEEEEE" CornerRadius="8" Padding="12,12"><TextBlock Text="◉   挂机控制台" FontWeight="SemiBold"/></Border>
          <TextBlock Text="01   确认目标页面" Foreground="#777777" Margin="13,25,0,0" FontSize="12"/>
          <TextBlock Text="02   识别课程状态" Foreground="#777777" Margin="13,22,0,0" FontSize="12"/>
          <TextBlock Text="03   播放并监测完成" Foreground="#777777" Margin="13,22,0,0" FontSize="12"/>
          <TextBlock Text="04   测验独立复核" Foreground="#777777" Margin="13,22,0,0" FontSize="12"/>
          <Button x:Name="DeepSeekSettingsButton" Content="DeepSeek 设置" Height="34" FontSize="11" Padding="8,0" Margin="0,29,0,0"/>
          <Button x:Name="GlmSettingsButton" Content="智谱 GLM 设置" Height="34" FontSize="11" Padding="8,0" Margin="0,8,0,0"/>
          <TextBlock x:Name="DeepSeekStatus" Text="测验需先配置自己的 Key" Foreground="#999999" TextWrapping="Wrap" FontSize="10" Margin="2,9,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
          <Border Height="1" Background="#E8E8E8" Margin="0,0,0,17"/>
          <TextBlock Text="本地识别 · 双模型审核" Foreground="#777777" FontSize="11"/>
          <TextBlock Text="Windows 11  ·  v0.6.15" Foreground="#A0A0A0" FontSize="10" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
      </ScrollViewer>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid Margin="30,27,30,22" MinHeight="750" MinWidth="820">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <StackPanel><TextBlock Text="挂机控制台" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="准备好页面，剩下的交给随课。" Foreground="#858585" FontSize="12" Margin="0,9,0,0"/></StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#ECECEC" CornerRadius="12" Padding="12,6">
          <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#777777" Margin="0,0,7,0"/><TextBlock x:Name="StatusBadge" Text="等待确认" FontSize="11" Foreground="#646464"/></StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,24,0,20" Padding="18,15">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="目标屏幕" FontSize="11" Foreground="#888888" Margin="0,0,0,7"/><ComboBox x:Name="ScreenPicker" MaxWidth="360" HorizontalAlignment="Left" MinWidth="290"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button x:Name="CalibrateButton" Content="目录区域" Height="34" FontSize="12" Margin="0,0,8,0" ToolTip="在目录页校准章节列表与整体状态点"/>
            <Button x:Name="CalibrateCourseButton" Content="课程页区域" Height="34" FontSize="12" Margin="0,0,8,0" ToolTip="请先打开课程页，再校准任务圆点、视频和返回文字"/>
            <Button x:Name="CalibrateQuizButton" Content="测验区域" Height="34" FontSize="12" Margin="0,0,8,0" ToolTip="在章节测验顶部校准标题状态区和整个题目内容视口"/>
            <Button x:Name="DefaultRegionsButton" Content="重置区域" Height="34" FontSize="12"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <WrapPanel>
              <Button x:Name="GuideButton" Content="手动引导 · 框选全部区域" Style="{StaticResource Primary}" Height="34" FontSize="12" Margin="0,0,8,6"/>
              <ComboBox x:Name="DiagnosticKind" SelectedIndex="0" Width="100" Margin="0,0,8,6"><ComboBoxItem Content="目录页"/><ComboBoxItem Content="课程页"/><ComboBoxItem Content="测验页"/></ComboBox>
              <Button x:Name="DiagnosticButton" Content="只识别 / 导出诊断" Height="34" FontSize="12" Margin="0,0,0,6"/>
            </WrapPanel>
            <TextBlock x:Name="CalibrationHint" Text="首次使用：7 个区域均需手动框选并确认" FontSize="11" Foreground="#777777" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="20,19">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="84"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,12"><TextBlock x:Name="ObservationTitle" Text="页面观察" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CaptureTime" Text="尚未截图" Foreground="#999999" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="9" ClipToBounds="True">
              <Grid><Image x:Name="StatusPreview" Stretch="Uniform" Margin="8"/>
                <StackPanel x:Name="StatusPlaceholder" VerticalAlignment="Center" Margin="17,0"><TextBlock Text="区域 02  /  整体完成状态" FontSize="11" Foreground="#969696"/><StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Ellipse Width="12" Height="12" Fill="#CDCDCD"/><Border Width="102" Height="7" Background="#DDDDDD" CornerRadius="3" Margin="10,0,0,0" VerticalAlignment="Center"/><Border Width="56" Height="7" Background="#E4E4E4" CornerRadius="3" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,17,0,10"><TextBlock x:Name="ContentRegionTitle" Text="区域 01  /  章节目录" Foreground="#878787" FontSize="11"/><TextBlock x:Name="DotResult" Text="等待识别" Foreground="#9B9B9B" FontSize="10" HorizontalAlignment="Right"/></Grid>
            <Border Grid.Row="3" Background="#F7F7F7" CornerRadius="9" ClipToBounds="True" MinHeight="135">
              <Grid><Image x:Name="ListPreview" Stretch="Uniform" Margin="7"/>
                <StackPanel x:Name="ListPlaceholder" VerticalAlignment="Center" Margin="18,9">
                  <Border Height="21" Background="#EEEEEE" CornerRadius="4" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="5,0,0,15"><Ellipse Width="11" Height="11" Fill="#CCCCCC"/><Border Width="161" Height="7" Background="#DDDDDD" CornerRadius="3" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="5,0,0,15"><Ellipse Width="11" Height="11" Fill="#CCCCCC"/><Border Width="130" Height="7" Background="#DDDDDD" CornerRadius="3" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="5,0,0,0"><Ellipse Width="11" Height="11" Fill="#CCCCCC"/><Border Width="147" Height="7" Background="#DDDDDD" CornerRadius="3" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="4" x:Name="RegionHint" Text="截图将在开始后显示，区域可手动校准。" Foreground="#999999" FontSize="10" Margin="0,11,0,0" TextWrapping="Wrap"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="21,20">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="双模型审核与仲裁" FontSize="15" FontWeight="SemiBold"/>
              <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Button x:Name="ManualContinueButton" Content="已填入标准答案，继续" Style="{StaticResource Primary}" FontSize="12" Height="42" IsEnabled="False"/>
                <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0">
                  <TextBlock x:Name="ManualHint" TextWrapping="Wrap" Foreground="#916A24" FontSize="11" LineHeight="19"/>
                </ScrollViewer>
              </StackPanel>
              <ScrollViewer x:Name="DecisionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="158" Margin="0,10,0,17">
                <TextBlock x:Name="DecisionDetails" Text="等待题目。两份答案、审批原因和仲裁票数将在此显示。同义不同说法也算一致。" TextWrapping="Wrap" FontSize="11" Foreground="#666666" LineHeight="19"/>
              </ScrollViewer>
              <StackPanel x:Name="RunControls">
              <TextBlock Text="开始本次任务" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="先打开课程目录页，并保持目标页面无遮挡。" Foreground="#888888" FontSize="12" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,21"/>
              <TextBlock Text="第 1 步 · 确认页面" Foreground="#999999" FontSize="10" Margin="0,0,0,8"/>
              <Button x:Name="ConfirmButton" Content="确认并预检目录页"/>
              <TextBlock Text="第 2 步 · 开始运行" Foreground="#999999" FontSize="10" Margin="0,19,0,8"/>
              <Button x:Name="StartButton" Content="确定开始刷课挂机  →" Style="{StaticResource Primary}" IsEnabled="False" Height="43"/>
              <TextBlock x:Name="RunHint" Text="开始后窗口自动最小化，预留 3 秒切换页面。" Foreground="#999999" TextWrapping="Wrap" FontSize="10" LineHeight="18" Margin="0,10,0,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Row="3" Style="{StaticResource Card}" Padding="17,13">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock Text="运行记录" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="PhaseText" Text="准备就绪" Foreground="#999999" FontSize="10" HorizontalAlignment="Right"/></Grid>
          <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" Background="Transparent" Margin="-3,8,0,0" FontSize="11" Foreground="#818181" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,2"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Border>
      <Grid Grid.Row="4" Margin="1,13,1,0"><TextBlock Text="视频自动监测 · 测验自动提交，漏题补查一次。" FontSize="10" Foreground="#999999"/><TextBlock Text="题目图发往 DeepSeek 与智谱" FontSize="10" Foreground="#AAAAAA" HorizontalAlignment="Right"/></Grid>
    </Grid>
    </ScrollViewer>
    <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="22,8">
      <DockPanel>
        <Button x:Name="StopButton" DockPanel.Dock="Right" Content="停止任务" Width="140" Height="34" IsEnabled="False" FontSize="12"/>
        <TextBlock Text="随时按 F8 停止" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
